import pandas as pd

# 1. Define the two fuzzy sets
A = {1: 0.3, 2: 0.7, 3: 1.0}
B = {'a': 0.4, 'b': 0.8, 'c': 1.0}

def cartesian_product(A, B):
    """
    Calculates the Cartesian product of two fuzzy sets.
    Returns a dictionary with tuple keys (x, y) and the minimum membership value.
    """
    # Dictionary comprehension mapping every combination of A and B
    return {(x, y): min(A[x], B[y]) for x in A for y in B}

def relation_to_matrix(relation, A_keys, B_keys):
    """
    Converts the fuzzy relation dictionary into a 2D Pandas DataFrame.
    """
    matrix = pd.DataFrame(index=A_keys, columns=B_keys)
    for (x, y), value in relation.items():
        matrix.loc[x, y] = value
    return matrix.astype(float)

if __name__ == "__main__":
    # 2. Execute the function
    relation = cartesian_product(A, B)
    
    # 3. Print the results exactly as required
    print("Fuzzy Relation (A x B):")
    for k, v in relation.items():
        print(f"{k}: {v}")
        
    # 4. Display as a 2D Matrix
    relation_matrix = relation_to_matrix(relation, list(A.keys()), list(B.keys()))
    print("\nFuzzy Relation Matrix:")
    print(relation_matrix)

