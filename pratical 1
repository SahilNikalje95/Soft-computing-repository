# MP neuron Aggregation + Activation Step Functions 
def mcculloch_pitts(inputs,weights,threshold):
    weighted_sum = sum(x*w for x,w in zip(inputs,weights))
    if weighted_sum >= threshold:
        return 1
    else:
        return 0 
# Generate Truth Table for AND, OR & NOT Logical Gates 
def test_logic_gate(gate_name,input_data,weights,threshold):
    print(f"----{gate_name} GATE TRUTH TABLE ----")
    print(f"Inputs\t|\t Ouput")
    print("-" *30)
    
    for inputs in input_data:
        output = mcculloch_pitts(inputs,weights,threshold)
        print(f"{inputs}\t|\t{output}")
        print("-"*30)

