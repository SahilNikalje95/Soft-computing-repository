import numpy as np

def maxnet(activations, epsilon=0.1, max_iter=100):
    # Epsilon must be < 1/N. For 4 inputs, 0.1 is perfect (0.1 < 0.25)
    x = np.array(activations, dtype=float)
    n = len(x)
    
    for iteration in range(max_iter):
        x_new = np.zeros_like(x)
        
        for i in range(n):
            # Sum of all OTHER neurons' activations
            inhibitory_sum = np.sum(x) - x[i]
            
            # MaxNet Formula: New = Old - (epsilon * Sum of others)
            x_new[i] = x[i] - epsilon * inhibitory_sum
            
        # Apply ReLU (Turn negative values into 0)
        x_new = np.maximum(x_new, 0)
        
        # FIXED: Save the state BEFORE checking if we should break!
        x = x_new.copy()
        
        # Stop condition: Only 1 neuron is left standing
        if np.count_nonzero(x) == 1:
            print(f"Converged at iteration {iteration + 1}!")
            break
            
    winner_index = np.argmax(x)
    return winner_index, x

if __name__ == "__main__":
    # Example usage
    activations = [0.3, 0.9, 0.6, 0.2]
    
    winner, final_output = maxnet(activations)
    
    print("Final neuron activations:", final_output)
    print(f"Winning neuron index: {winner} (activation: {final_output[winner]:.4f})")
