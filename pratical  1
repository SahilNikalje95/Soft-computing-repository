
def fuzzy_union(A, B):
    """
    Fuzzy Union (A U B) = max(A(x), B(x))
    """
    return {x: max(A.get(x, 0), B.get(x, 0)) for x in set(A) | set(B)}

def fuzzy_intersection(A, B):
    """
    Fuzzy Intersection (A ∩ B) = min(A(x), B(x))
    """
    return {x: min(A.get(x, 0), B.get(x, 0)) for x in set(A) | set(B)}

def fuzzy_complement(A):
    """
    Fuzzy Complement (~A) = 1 - A(x)
    Note: We round to 2 decimal places to fix Python's floating-point artifacts.
    """
    return {x: round(1 - A[x], 2) for x in A}

def de_morgan_laws(A, B):
    # Law 1: ~(A U B) = ~A ∩ ~B
    lhs1 = fuzzy_complement(fuzzy_union(A, B))
    rhs1 = fuzzy_intersection(fuzzy_complement(A), fuzzy_complement(B))
    
    # Law 2: ~(A ∩ B) = ~A U ~B
    lhs2 = fuzzy_complement(fuzzy_intersection(A, B))
    rhs2 = fuzzy_union(fuzzy_complement(A), fuzzy_complement(B))
    
    return lhs1, rhs1, lhs2, rhs2

if __name__ == "__main__":
    # Example fuzzy sets
    A = {'x1': 0.3, 'x2': 0.7, 'x3': 1.0}
    B = {'x1': 0.5, 'x2': 0.4, 'x3': 0.8}
    
    # Apply De Morgan's Laws
    lhs1, rhs1, lhs2, rhs2 = de_morgan_laws(A, B)
    
    # Display results cleanly
    print("=========================================")
    print("Law 1: ~(A V B) = ~A ^ ~B")
    print("=========================================")
    print("LHS: ", lhs1)
    print("RHS: ", rhs1)
    
    # Check if LHS matches RHS
    if lhs1 == rhs1:
        print("-> Law 1 is PROVED!")
        
    print("\n=========================================")
    print("Law 2: ~(A ^ B) = ~A V ~B")
    print("=========================================")
    print("LHS: ", lhs2)
    print("RHS: ", rhs2)
    
    # Check if LHS matches RHS
    if lhs2 == rhs2:
        print("-> Law 2 is PROVED!")
